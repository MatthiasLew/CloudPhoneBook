# Database Configuration (Postgres for docker/production or sqlite for local quick dev)
DATABASE_URL=sqlite:///./cloudphonebook.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cloudphonebook

# JWT Secret & Expiration
JWT_SECRET_KEY=change-this-secret-key-in-production-random-64-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Project Config
PROJECT_NAME=CloudPhoneBook API
VERSION=0.1.0
